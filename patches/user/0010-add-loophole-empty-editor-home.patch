+/*--------------------------------------------------------------------------------------
+ *  Copyright 2026 Loophole AI, Inc. All rights reserved.
+ *  See LICENSE.txt for more information.
+ *--------------------------------------------------------------------------------------*/
+
+/* The home screen of an empty editor: logo, tagline and shortcuts (see editorGroupWatermark.ts). */
+
+.monaco-workbench .part.editor > .content .editor-group-container > .editor-group-watermark-wrapper > .editor-group-watermark.loophole-home {
+	max-width: 340px;
+}
+
+/* The logo: the Loophole mark in the foreground color, instead of the faint letterpress image. */
+.monaco-workbench .part.editor > .content .editor-group-container > .editor-group-watermark-wrapper > .editor-group-watermark.loophole-home .letterpress {
+	width: 96px;
+	max-width: 96px;
+	max-height: 96px;
+	background-image: none;
+	background-color: var(--vscode-foreground);
+	-webkit-mask: url('./loophole-mark.svg') center / contain no-repeat;
+	mask: url('./loophole-mark.svg') center / contain no-repeat;
+	opacity: 0.9;
+}
+
+.monaco-workbench .part.editor > .content .editor-group-container > .editor-group-watermark-wrapper > .editor-group-watermark.loophole-home .loophole-home-heading {
+	display: flex;
+	flex-direction: column;
+	align-items: center;
+	gap: 6px;
+	text-align: center;
+}
+
+.monaco-workbench .part.editor > .content .editor-group-container > .editor-group-watermark-wrapper > .editor-group-watermark.loophole-home .loophole-home-title {
+	margin: 0;
+	font-size: 24px;
+	font-weight: 600;
+	line-height: 1.2;
+	color: var(--vscode-foreground);
+}
+
+.monaco-workbench .part.editor > .content .editor-group-container > .editor-group-watermark-wrapper > .editor-group-watermark.loophole-home .loophole-home-tagline {
+	margin: 0;
+	font-size: 14px;
+	color: var(--vscode-descriptionForeground);
+}
+
+/* a short group has no room for the heading and the list */
+.monaco-workbench .part.editor > .content .editor-group-container.max-height-478px > .editor-group-watermark-wrapper > .editor-group-watermark.loophole-home .loophole-home-heading {
+	display: none;
+}
