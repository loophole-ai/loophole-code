+import './media/emptyEditorHome.css';
+import { $, append } from '../../../../base/browser/dom.js';
+import { localize } from '../../../../nls.js';
+
+export interface IEmptyEditorHomeShortcut {
+
+	/** The command whose keybinding is shown. */
+	readonly id: string;
+
+	readonly label: string;
+
+	/**
+	 * The command is contributed by the built-in Loophole agent. Its keybindings are known as soon as the
+	 * extension is registered, but the command itself only exists once the extension has activated.
+	 */
+	readonly isAgentCommand?: boolean;
+}
+
+/**
+ * Commands of the Loophole agent (built-in Kilo extension) that the home screen points at.
+ * Which keys they use comes from the extension's keybindings, so nothing is hardcoded here.
+ */
+export const AgentCommand = {
+	Chat: 'kilo-code.new.focusChatInput',
+	SuggestEdits: 'kilo-code.new.autocomplete.generateSuggestions',
+	AddToContext: 'kilo-code.new.addToContext',
+	AgentManager: 'kilo-code.new.agentManagerOpen',
+} as const;
+
+/**
+ * The shortcuts worth surfacing on an empty editor. A shortcut without a keybinding
+ * (the person may have unbound it) is left out, so the list only ever shows keys that do something.
+ */
+export const EMPTY_EDITOR_HOME_SHORTCUTS: readonly IEmptyEditorHomeShortcut[] = [
+	{ id: AgentCommand.Chat, label: localize('emptyEditorHome.chat', "Chat"), isAgentCommand: true },
+	{ id: AgentCommand.SuggestEdits, label: localize('emptyEditorHome.suggestEdits', "Suggest Edits"), isAgentCommand: true },
+	{ id: AgentCommand.AddToContext, label: localize('emptyEditorHome.addToContext', "Add to Context"), isAgentCommand: true },
+	{ id: AgentCommand.AgentManager, label: localize('emptyEditorHome.agentManager', "Agent Manager"), isAgentCommand: true },
+	{ id: 'workbench.action.quickOpen', label: localize('emptyEditorHome.goToFile', "Go to File") },
+	{ id: 'workbench.action.showCommands', label: localize('emptyEditorHome.showCommands', "Show All Commands") },
+	{ id: 'workbench.action.openGlobalKeybindings', label: localize('emptyEditorHome.keyboardShortcuts', "Keyboard Shortcuts") },
+	{ id: 'workbench.action.terminal.toggleTerminal', label: localize('emptyEditorHome.toggleTerminal', "Toggle Terminal") },
+];
+
+/** The heading under the logo. */
+export function renderEmptyEditorHomeHeading(container: HTMLElement): void {
+	append(container, $('h1.loophole-home-title')).textContent = localize('emptyEditorHome.title', "Beyond Code Completion");
+	append(container, $('p.loophole-home-tagline')).textContent = localize('emptyEditorHome.tagline', "An Agentic AI IDE");
+}
