+ *  See LICENSE.txt for more information.
+ *--------------------------------------------------------------------------------------*/
+
+import './media/loopholeOnboarding.css';
+import { $, addDisposableListener, append, clearNode, EventType, getActiveElement, getWindow } from '../../../../base/browser/dom.js';
+import { Button } from '../../../../base/browser/ui/button/button.js';
+import { disposableTimeout } from '../../../../base/common/async.js';
+import { Emitter, Event } from '../../../../base/common/event.js';
+import { Disposable, DisposableStore } from '../../../../base/common/lifecycle.js';
+import { localize } from '../../../../nls.js';
+import { ConfigurationTarget, IConfigurationService } from '../../../../platform/configuration/common/configuration.js';
+import { defaultButtonStyles } from '../../../../platform/theme/browser/defaultStyles.js';
+import { editorBackground, editorForeground } from '../../../../platform/theme/common/colors/editorColors.js';
+import { ACTIVITY_BAR_BACKGROUND, TITLE_BAR_ACTIVE_BACKGROUND } from '../../../common/theme.js';
+import { IWorkbenchColorTheme, IWorkbenchThemeService } from '../../../services/themes/common/workbenchThemeService.js';
+import { ILayoutService } from '../../../../platform/layout/browser/layoutService.js';
+import { IExtensionTransferService, TransferEditorType, transferEditorTypes, TransferItemKind } from '../common/extensionTransfer.js';
+import { LOOPHOLE_ONBOARDING_THEMES } from '../common/loopholeOnboarding.js';
+
+interface IThemeCard {
+	readonly id: string;
+	readonly name: string;
+	readonly theme: IWorkbenchColorTheme;
+}
+
+const FADE_OUT_MS = 500;
+
+/**
+ * Full-window first-run experience: welcome, theme picker and import from another editor.
+ * Plain DOM (no framework), colored with the `--vscode-*` variables so it follows whichever theme is active.
+ */
+export class LoopholeOnboarding extends Disposable {
+
+	private readonly _onDidComplete = this._register(new Emitter<void>());
+	/** Fires when the person enters Loophole or skips. */
+	readonly onDidComplete: Event<void> = this._onDidComplete.event;
+
+	private readonly root: HTMLElement;
+	private readonly content: HTMLElement;
+	private readonly dots: HTMLElement[] = [];
+	private readonly skipButton: HTMLButtonElement;
+	private readonly pageDisposables = this._register(new DisposableStore());
+
+	private readonly previouslyFocused = getActiveElement();
+	private themeCards: Promise<IThemeCard[]> | undefined;
+	private selectedThemeId: string | undefined;
+	private completed = false;
+
+	private readonly pages: ReadonlyArray<(store: DisposableStore) => HTMLElement | undefined> = [
+		store => this.renderWelcome(store),
+		store => this.renderThemes(store),
+		store => this.renderImport(store),
+	];
+
+	constructor(
+		@ILayoutService private readonly layoutService: ILayoutService,
+		@IWorkbenchThemeService private readonly themeService: IWorkbenchThemeService,
+		@IConfigurationService private readonly configurationService: IConfigurationService,
+		@IExtensionTransferService private readonly extensionTransferService: IExtensionTransferService,
+	) {
+		super();
+
+		this.root = $('.loophole-onboarding');
+		this.root.setAttribute('role', 'dialog');
+		this.root.setAttribute('aria-modal', 'true');
+		this.root.setAttribute('aria-label', localize('loopholeOnboarding.label', "Welcome to Loophole"));
+
+		this.skipButton = append(this.root, $('button.loophole-onboarding-skip', { type: 'button' })) as HTMLButtonElement;
+		this.skipButton.textContent = localize('loopholeOnboarding.skip', "Skip");
+		this._register(addDisposableListener(this.skipButton, EventType.CLICK, () => this.complete()));
+
+		this.content = append(this.root, $('.loophole-onboarding-content'));
+
+		const dots = append(this.root, $('.loophole-onboarding-dots'));
+		dots.setAttribute('aria-hidden', 'true');
+		for (let i = 0; i < this.pages.length; i++) {
+			this.dots.push(append(dots, $('span.loophole-onboarding-dot')));
+		}
+
+		// keep keyboard focus inside the overlay, the workbench is covered by it
+		this._register(addDisposableListener(this.root, EventType.KEY_DOWN, e => this.trapFocus(e)));
+
+		this.layoutService.mainContainer.appendChild(this.root);
+		this.showPage(0);
+	}
+
+	// ---------------- pages ----------------
+
+	private showPage(index: number): void {
+		this.pageDisposables.clear();
+		clearNode(this.content);
+
+		const page = this.pages[index](this.pageDisposables);
+		if (page) {
+			this.content.appendChild(page);
+		}
+
+		this.dots.forEach((dot, i) => dot.classList.toggle('active', i === index));
+		this.skipButton.classList.toggle('hidden', index === this.pages.length - 1);
+
+		const focusTarget = this.content.querySelector<HTMLElement>('.loophole-onboarding-primary');
+		focusTarget?.focus();
+	}
+
+	private renderWelcome(store: DisposableStore): HTMLElement {
+		const page = $('.loophole-onboarding-page.welcome');
+
+		append(page, $('.loophole-onboarding-logo')).setAttribute('aria-hidden', 'true');
+		append(page, $('h1.loophole-onboarding-title')).textContent = localize('loopholeOnboarding.welcome', "Welcome to Loophole");
+
+		const actions = append(page, $('.loophole-onboarding-actions.fade-in-late'));
+		this.addButton(store, actions, localize('loopholeOnboarding.getStarted', "Get Started"), () => this.showPage(1), { primary: true });
+
+		return page;
+	}
+
+	private renderThemes(store: DisposableStore): HTMLElement {
+		const page = $('.loophole-onboarding-page');
+		append(page, $('h1.loophole-onboarding-title')).textContent = localize('loopholeOnboarding.chooseTheme', "Choose your theme");
+
+		const grid = append(page, $('.loophole-onboarding-themes'));
+		grid.setAttribute('role', 'group');
+		grid.setAttribute('aria-label', localize('loopholeOnboarding.themes', "Color themes"));
+
+		this.getThemeCards().then(cards => {
+			if (store.isDisposed) {
+				return;
+			}
+
+			const current = this.themeService.getColorTheme().settingsId;
+			this.selectedThemeId ??= cards.find(card => card.id === current)?.id;
+
+			const buttons: HTMLButtonElement[] = [];
+			const updateSelection = () => buttons.forEach(button => {
+				const selected = button.dataset.themeId === this.selectedThemeId;
+				button.classList.toggle('selected', selected);
+				button.setAttribute('aria-pressed', String(selected));
+			});
+
+			for (const card of cards) {
+				const button = append(grid, $('button.loophole-onboarding-theme', { type: 'button' })) as HTMLButtonElement;
+				button.dataset.themeId = card.id;
+				this.renderThemePreview(append(button, $('.preview')), card.theme);
+				append(button, $('.name')).textContent = card.name;
+				append(button, $('.check.codicon.codicon-check'));
+				buttons.push(button);
+
+				store.add(addDisposableListener(button, EventType.CLICK, () => {
+					this.selectedThemeId = card.id;
+					updateSelection();
+					this.themeService.setColorTheme(card.theme, ConfigurationTarget.USER);
+				}));
+			}
+
+			updateSelection();
+		});
+
+		const actions = append(page, $('.loophole-onboarding-actions'));
+		this.addButton(store, actions, localize('loopholeOnboarding.back', "Back"), () => this.showPage(0), { primary: false });
+		this.addButton(store, actions, localize('loopholeOnboarding.next', "Next"), () => this.showPage(2), { primary: true });
+
+		return page;
+	}
+
+	private renderImport(store: DisposableStore): HTMLElement {
+		const page = $('.loophole-onboarding-page');
+		append(page, $('h1.loophole-onboarding-title')).textContent = localize('loopholeOnboarding.importTitle', "Import your settings");
+		append(page, $('p.loophole-onboarding-subtitle')).textContent = localize('loopholeOnboarding.importDescription', "Bring your settings, keybindings and extensions over from another editor. Files that already exist in Loophole are backed up first.");
+
+		const importButtons = append(page, $('.loophole-onboarding-import'));
+		const status = append(page, $('.loophole-onboarding-status'));
+		status.setAttribute('role', 'status');
+
+		const buttons: Button[] = [];
+		for (const editor of transferEditorTypes) {
+			const button = this.addButton(store, importButtons, localize('loopholeOnboarding.importFrom', "Import from {0}", editor), async () => {
+				buttons.forEach(b => b.enabled = false);
+				status.className = 'loophole-onboarding-status';
+				status.textContent = localize('loopholeOnboarding.importing', "Importing from {0}…", editor);
+
+				try {
+					await this.importFrom(editor, status);
+				} finally {
+					buttons.forEach(b => b.enabled = true);
+				}
+			}, { primary: false });
+			buttons.push(button);
+		}
+
+		const actions = append(page, $('.loophole-onboarding-actions'));
+		this.addButton(store, actions, localize('loopholeOnboarding.back', "Back"), () => this.showPage(1), { primary: false });
+		this.addButton(store, actions, localize('loopholeOnboarding.enter', "Enter Loophole"), () => this.complete(), { primary: true });
+
+		return page;
+	}
+
+	// ---------------- import ----------------
+
+	private async importFrom(editor: TransferEditorType, status: HTMLElement): Promise<void> {
+		let imported: readonly TransferItemKind[] = [];
+		let errors: readonly string[] = [];
+		try {
+			({ imported, errors } = await this.extensionTransferService.transferFromEditor(editor));
+		} catch (error) {
+			errors = [String(error instanceof Error ? error.message : error)];
+		}
+
+		if (imported.includes('settings')) {
+			await this.keepChosenTheme();
+		}
+
+		if (errors.length) {
+			status.classList.add('error');
+			status.textContent = localize('loopholeOnboarding.importFailed', "Could not import everything from {0}:\n{1}", editor, errors.join('\n'));
+		} else if (imported.length === 0) {
+			status.textContent = localize('loopholeOnboarding.importNothing', "No {0} settings were found on this computer.", editor);
+		} else {
+			status.classList.add('success');
+			status.textContent = localize('loopholeOnboarding.importDone', "Imported from {0}. Restart Loophole if the imported extensions do not show up.", editor);
+		}
+	}
+
+	/** Importing replaces settings.json: if it did not set a theme, bring back the one picked on the theme page. */
+	private async keepChosenTheme(): Promise<void> {
+		if (!this.selectedThemeId) {
+			return;
+		}
+
+		await this.configurationService.reloadConfiguration(ConfigurationTarget.USER);
+		if (this.configurationService.inspect('workbench.colorTheme').userValue === undefined) {
+			const card = (await this.getThemeCards()).find(c => c.id === this.selectedThemeId);
+			if (card) {
+				await this.themeService.setColorTheme(card.theme, ConfigurationTarget.USER);
+			}
+		}
+	}
+
+	// ---------------- themes ----------------
+
+	private getThemeCards(): Promise<IThemeCard[]> {
+		this.themeCards ??= this.themeService.getColorThemes().then(themes => {
+			const cards: IThemeCard[] = [];
+			for (const id of LOOPHOLE_ONBOARDING_THEMES) {
+				const theme = themes.find(t => t.settingsId === id);
+				if (theme) {
+					cards.push({ id, name: theme.label, theme });
+				}
+			}
+			return cards;
+		});
+		return this.themeCards;
+	}
+
+	/** A tiny editor drawn with the colors of the theme itself, so every card is accurate. */
+	private renderThemePreview(preview: HTMLElement, theme: IWorkbenchColorTheme): void {
+		const foreground = theme.getColor(editorForeground)?.toString();
+		const style = preview.style;
+		style.setProperty('--preview-background', theme.getColor(editorBackground)?.toString() ?? 'transparent');
+		style.setProperty('--preview-foreground', foreground ?? 'inherit');
+		style.setProperty('--preview-bar', (theme.getColor(TITLE_BAR_ACTIVE_BACKGROUND) ?? theme.getColor(ACTIVITY_BAR_BACKGROUND))?.toString() ?? 'transparent');
+		style.setProperty('--preview-keyword', tokenColor(theme, ['keyword', 'storage.type'], foreground));
+		style.setProperty('--preview-function', tokenColor(theme, ['entity.name.function', 'support.function'], foreground));
+		style.setProperty('--preview-comment', tokenColor(theme, ['comment'], foreground));
+
+		append(preview, $('.bar'));
+		const code = append(preview, $('.code'));
+		const line = (indent: boolean, parts: [string, string?][]) => {
+			const element = append(code, $('div', indent ? { class: 'indent' } : undefined));
+			for (const [text, kind] of parts) {
+				append(element, $('span', kind ? { class: kind } : undefined)).textContent = text;
+			}
+		};
+		line(false, [['function', 'keyword'], [' '], ['add', 'function'], ['(x, y) {']]);
+		line(true, [['return', 'keyword'], [' x + y;']]);
+		line(true, [['// adds two numbers', 'comment']]);
+		line(false, [['}']]);
+	}
+
+	// ---------------- helpers ----------------
+
+	private addButton(store: DisposableStore, container: HTMLElement, label: string, onClick: () => void, options: { primary: boolean }): Button {
+		const button = store.add(new Button(container, { ...defaultButtonStyles, secondary: !options.primary }));
+		button.label = label;
+		button.element.classList.add('loophole-onboarding-button');
+		if (options.primary) {
+			button.element.classList.add('loophole-onboarding-primary');
+		}
+		store.add(button.onDidClick(() => onClick()));
+		return button;
+	}
+
+	private trapFocus(e: KeyboardEvent): void {
+		if (e.key !== 'Tab') {
+			return;
+		}
+
+		const focusable = Array.from(this.root.querySelectorAll<HTMLElement>('button:not([disabled]):not(.hidden), .monaco-button:not(.disabled)'));
+		if (focusable.length === 0) {
+			return;
+		}
+
+		const first = focusable[0];
+		const last = focusable[focusable.length - 1];
+		const active = getActiveElement();
+		if (e.shiftKey && (active === first || !this.root.contains(active))) {
+			e.preventDefault();
+			last.focus();
+		} else if (!e.shiftKey && (active === last || !this.root.contains(active))) {
+			e.preventDefault();
+			first.focus();
+		}
+	}
+
+	private complete(): void {
+		if (this.completed) {
+			return;
+		}
+		this.completed = true;
+		this._onDidComplete.fire();
+
+		this.root.classList.add('closing');
+		this.root.setAttribute('aria-hidden', 'true');
+		if (this.previouslyFocused instanceof getWindow(this.root).HTMLElement) {
+			this.previouslyFocused.focus();
+		}
+		this._register(disposableTimeout(() => this.dispose(), FADE_OUT_MS));
+	}
+
+	override dispose(): void {
+		this.root.remove();
+		super.dispose();
+	}
+}
+
+/** The color a theme gives to the first of these TextMate scopes it styles, preferring the most specific rule. */
+function tokenColor(theme: IWorkbenchColorTheme, scopes: string[], fallback: string | undefined): string {
+	for (const scope of scopes) {
+		let best: { specificity: number; color: string } | undefined;
+		for (const rule of theme.tokenColors) {
+			const foreground = rule.settings.foreground;
+			if (!foreground || !rule.scope) {
+				continue;
+			}
+
+			const ruleScopes = Array.isArray(rule.scope) ? rule.scope : rule.scope.split(',');
+			for (const ruleScope of ruleScopes.map(s => s.trim())) {
+				const matches = ruleScope === scope || scope.startsWith(`${ruleScope}.`);
+				if (matches && (!best || ruleScope.length >= best.specificity)) {
+					best = { specificity: ruleScope.length, color: foreground };
+				}
+			}
+		}
+		if (best) {
+			return best.color;
+		}
+	}
+	return fallback ?? 'inherit';
+}
