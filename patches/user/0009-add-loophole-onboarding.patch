+
+import { createDecorator } from '../../../../platform/instantiation/common/instantiation.js';
+
+/** Set once the person has finished (or skipped) the onboarding. */
+export const LOOPHOLE_ONBOARDING_COMPLETED_KEY = 'loopholeOnboarding.completed';
+
+/** The color themes offered on the theme page, by their id in `workbench.colorTheme`. */
+export const LOOPHOLE_ONBOARDING_THEMES: readonly string[] = ['Loophole Dark', 'Loophole Light', 'Dark 2026', 'Light 2026'];
+
+export const ILoopholeOnboardingService = createDecorator<ILoopholeOnboardingService>('loopholeOnboardingService');
+
+export interface ILoopholeOnboardingService {
+
+	readonly _serviceBrand: undefined;
+
+	/** Opens the onboarding on top of the workbench. Does nothing if it is already open. */
+	show(): void;
+}
