+/*--------------------------------------------------------------------------------------
+ *  Copyright 2026 Loophole AI, Inc. All rights reserved.
+ *  See LICENSE.txt for more information.
+ *--------------------------------------------------------------------------------------*/
+
+import { Disposable } from '../../../../base/common/lifecycle.js';
+import { localize2 } from '../../../../nls.js';
+import { Categories } from '../../../../platform/action/common/actionCommonCategories.js';
+import { Action2, registerAction2 } from '../../../../platform/actions/common/actions.js';
+import { InstantiationType, registerSingleton } from '../../../../platform/instantiation/common/extensions.js';
+import { IInstantiationService, ServicesAccessor } from '../../../../platform/instantiation/common/instantiation.js';
+import { IStorageService, StorageScope, StorageTarget } from '../../../../platform/storage/common/storage.js';
+import { IWorkbenchContribution, registerWorkbenchContribution2, WorkbenchPhase } from '../../../common/contributions.js';
+import { IWorkbenchEnvironmentService } from '../../../services/environment/common/environmentService.js';
+import { LoopholeOnboarding } from '../browser/loopholeOnboarding.js';
+import { ILoopholeOnboardingService, LOOPHOLE_ONBOARDING_COMPLETED_KEY } from '../common/loopholeOnboarding.js';
+
+class LoopholeOnboardingService implements ILoopholeOnboardingService {
+
+	declare readonly _serviceBrand: undefined;
+
+	private onboarding: LoopholeOnboarding | undefined;
+
+	constructor(
+		@IInstantiationService private readonly instantiationService: IInstantiationService,
+		@IStorageService private readonly storageService: IStorageService,
+	) { }
+
+	show(): void {
+		if (this.onboarding) {
+			return;
+		}
+
+		const onboarding = this.onboarding = this.instantiationService.createInstance(LoopholeOnboarding);
+		onboarding.onDidComplete(() => {
+			this.storageService.store(LOOPHOLE_ONBOARDING_COMPLETED_KEY, true, StorageScope.APPLICATION, StorageTarget.USER);
+			this.onboarding = undefined;
+		});
+	}
+}
+
+registerSingleton(ILoopholeOnboardingService, LoopholeOnboardingService, InstantiationType.Delayed);
+
+/** Shows the onboarding on the first start, until it has been completed or skipped. */
+class LoopholeOnboardingContribution extends Disposable implements IWorkbenchContribution {
+
+	static readonly ID = 'workbench.contrib.loopholeOnboarding';
+
+	constructor(
+		@IStorageService storageService: IStorageService,
+		@IWorkbenchEnvironmentService environmentService: IWorkbenchEnvironmentService,
+		@ILoopholeOnboardingService onboardingService: ILoopholeOnboardingService,
+	) {
+		super();
+
+		if (environmentService.skipWelcome || storageService.getBoolean(LOOPHOLE_ONBOARDING_COMPLETED_KEY, StorageScope.APPLICATION, false)) {
+			return;
+		}
+
+		onboardingService.show();
+	}
+}
+
+registerWorkbenchContribution2(LoopholeOnboardingContribution.ID, LoopholeOnboardingContribution, WorkbenchPhase.AfterRestored);
+
+registerAction2(class ShowLoopholeOnboardingAction extends Action2 {
+
+	constructor() {
+		super({
+			id: 'workbench.action.showLoopholeOnboarding',
+			title: localize2('showLoopholeOnboarding', "Show Loophole Onboarding"),
+			category: Categories.Help,
+			f1: true,
+		});
+	}
+
+	run(accessor: ServicesAccessor): void {
+		accessor.get(ILoopholeOnboardingService).show();
+	}
+});
