+/*--------------------------------------------------------------------------------------
+ *  Copyright 2026 Loophole AI, Inc. All rights reserved.
+ *  See LICENSE.txt for more information.
+ *--------------------------------------------------------------------------------------*/
+
+.monaco-workbench .loophole-onboarding {
+	position: fixed;
+	inset: 0;
+	z-index: 3000; /* above quick input (2000) and dialogs (2600) */
+	display: flex;
+	align-items: center;
+	justify-content: center;
+	box-sizing: border-box;
+	padding: 32px;
+	overflow: auto;
+	background-color: var(--vscode-editor-background);
+	color: var(--vscode-foreground);
+	font-family: var(--vscode-font-family);
+	font-size: 14px;
+	opacity: 1;
+	transition: opacity 0.5s ease-in-out;
+}
+
+.monaco-workbench .loophole-onboarding.closing {
+	opacity: 0;
+	pointer-events: none;
+}
+
+.monaco-workbench .loophole-onboarding-content {
+	width: 100%;
+	max-width: 640px;
+	margin: auto;
+}
+
+.monaco-workbench .loophole-onboarding-page {
+	display: flex;
+	flex-direction: column;
+	align-items: center;
+	gap: 24px;
+	text-align: center;
+	animation: loophole-onboarding-fade-in 0.6s ease-out both;
+}
+
+.monaco-workbench .loophole-onboarding-title {
+	margin: 0;
+	font-size: 40px;
+	font-weight: 300;
+	line-height: 1.2;
+}
+
+.monaco-workbench .loophole-onboarding-subtitle {
+	max-width: 440px;
+	margin: 0;
+	line-height: 1.5;
+	color: var(--vscode-descriptionForeground);
+}
+
+/* ---- welcome ---- */
+
+.monaco-workbench .loophole-onboarding-logo {
+	width: 168px;
+	height: 168px;
+	background-color: var(--vscode-foreground);
+	-webkit-mask: url('./loophole-mark.svg') center / contain no-repeat;
+	mask: url('./loophole-mark.svg') center / contain no-repeat;
+	opacity: 0;
+	animation:
+		loophole-onboarding-logo-in 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) forwards,
+		loophole-onboarding-logo-float 6s ease-in-out 1.6s infinite alternate;
+}
+
+.monaco-workbench .loophole-onboarding-page.welcome .fade-in-late {
+	opacity: 0;
+	animation: loophole-onboarding-fade-in 1s ease-out 1s forwards;
+}
+
+@keyframes loophole-onboarding-logo-in {
+	from { opacity: 0; transform: scale(0.9); }
+	to { opacity: 0.85; transform: scale(1); }
+}
+
+@keyframes loophole-onboarding-logo-float {
+	from { opacity: 0.85; transform: translateY(0); }
+	to { opacity: 0.6; transform: translateY(-6px); }
+}
+
+@keyframes loophole-onboarding-fade-in {
+	from { opacity: 0; }
+	to { opacity: 1; }
+}
+
+/* ---- buttons ---- */
+
+.monaco-workbench .loophole-onboarding-actions {
+	display: flex;
+	justify-content: center;
+	gap: 8px;
+	margin-top: 8px;
+}
+
+.monaco-workbench .loophole-onboarding-actions .monaco-button,
+.monaco-workbench .loophole-onboarding-import .monaco-button {
+	width: auto;
+	min-width: 96px;
+	padding: 8px 20px;
+}
+
+.monaco-workbench .loophole-onboarding-skip {
+	position: absolute;
+	top: 16px;
+	right: 20px;
+	padding: 4px 8px;
+	border: none;
+	background: transparent;
+	color: var(--vscode-descriptionForeground);
+	font: inherit;
+	cursor: pointer;
+}
+
+.monaco-workbench .loophole-onboarding-skip:hover {
+	color: var(--vscode-foreground);
+}
+
+.monaco-workbench .loophole-onboarding-skip.hidden {
+	display: none;
+}
+
+.monaco-workbench .loophole-onboarding-skip:focus-visible,
+.monaco-workbench .loophole-onboarding-theme:focus-visible {
+	outline: 1px solid var(--vscode-focusBorder);
+	outline-offset: 2px;
+}
+
+/* ---- themes ---- */
+
+.monaco-workbench .loophole-onboarding-themes {
+	display: grid;
+	grid-template-columns: repeat(2, minmax(0, 1fr));
+	gap: 16px;
+	width: 100%;
+}
+
+.monaco-workbench .loophole-onboarding-theme {
+	position: relative;
+	display: flex;
+	flex-direction: column;
+	gap: 10px;
+	padding: 12px;
+	border: 2px solid var(--vscode-panel-border, transparent);
+	border-radius: 10px;
+	background: transparent;
+	color: var(--vscode-foreground);
+	font: inherit;
+	cursor: pointer;
+	transition: border-color 0.2s ease;
+}
+
+.monaco-workbench .loophole-onboarding-theme:hover {
+	border-color: var(--vscode-descriptionForeground);
+}
+
+.monaco-workbench .loophole-onboarding-theme.selected {
+	border-color: var(--vscode-focusBorder);
+}
+
+.monaco-workbench .loophole-onboarding-theme .check {
+	position: absolute;
+	top: 18px;
+	right: 18px;
+	display: none;
+	color: var(--vscode-focusBorder);
+}
+
+.monaco-workbench .loophole-onboarding-theme.selected .check {
+	display: block;
+}
+
+.monaco-workbench .loophole-onboarding-theme .preview {
+	display: flex;
+	flex-direction: column;
+	height: 128px;
+	overflow: hidden;
+	border-radius: 6px;
+	background-color: var(--preview-background);
+	color: var(--preview-foreground);
+	font-family: var(--monaco-monospace-font, monospace);
+	font-size: 11px;
+	text-align: left;
+}
+
+.monaco-workbench .loophole-onboarding-theme .preview .bar {
+	flex: none;
+	height: 14px;
+	background-color: var(--preview-bar);
+}
+
+.monaco-workbench .loophole-onboarding-theme .preview .code {
+	padding: 10px;
+	line-height: 1.6;
+	white-space: pre;
+}
+
+.monaco-workbench .loophole-onboarding-theme .preview .code .indent {
+	padding-left: 12px;
+}
+
+.monaco-workbench .loophole-onboarding-theme .preview .keyword { color: var(--preview-keyword); }
+.monaco-workbench .loophole-onboarding-theme .preview .function { color: var(--preview-function); }
+.monaco-workbench .loophole-onboarding-theme .preview .comment { color: var(--preview-comment); }
+
+.monaco-workbench .loophole-onboarding-theme .name {
+	font-weight: 500;
+}
+
+/* ---- import ---- */
+
+.monaco-workbench .loophole-onboarding-import {
+	display: flex;
+	flex-direction: column;
+	align-items: center;
+	gap: 8px;
+}
+
+.monaco-workbench .loophole-onboarding-status {
+	min-height: 20px;
+	max-width: 440px;
+	line-height: 1.5;
+	white-space: pre-line;
+	color: var(--vscode-descriptionForeground);
+}
+
+.monaco-workbench .loophole-onboarding-status.error {
+	color: var(--vscode-errorForeground);
+}
+
+/* ---- progress dots ---- */
+
+.monaco-workbench .loophole-onboarding-dots {
+	position: absolute;
+	bottom: 24px;
+	left: 0;
+	right: 0;
+	display: flex;
+	justify-content: center;
+	gap: 8px;
+}
+
+.monaco-workbench .loophole-onboarding-dot {
+	width: 6px;
+	height: 6px;
+	border-radius: 50%;
+	background-color: var(--vscode-descriptionForeground);
+	opacity: 0.4;
+	transition: opacity 0.3s ease;
+}
+
+.monaco-workbench .loophole-onboarding-dot.active {
+	opacity: 1;
+}
+
+/* ---- motion ---- */
+
+.monaco-reduce-motion .loophole-onboarding,
+.monaco-reduce-motion .loophole-onboarding * {
+	animation-duration: 0.01ms !important;
+	animation-delay: 0s !important;
+	animation-iteration-count: 1 !important;
+	transition-duration: 0.01ms !important;
+}
+
+@media (max-width: 520px) {
+	.monaco-workbench .loophole-onboarding-themes {
+		grid-template-columns: minmax(0, 1fr);
+	}
+}
