+
+import { Disposable } from '../../../../base/common/lifecycle.js';
+import { localize } from '../../../../nls.js';
+import { CommandsRegistry } from '../../../../platform/commands/common/commands.js';
+import { INativeHostService } from '../../../../platform/native/common/native.js';
+import { IProductService } from '../../../../platform/product/common/productService.js';
+import { IWorkbenchContribution, registerWorkbenchContribution2, WorkbenchPhase } from '../../../common/contributions.js';
+import { IStatusbarService, StatusbarAlignment } from '../../../services/statusbar/browser/statusbar.js';
+
+export const REPORT_ISSUE_COMMAND_ID = 'loophole.reportIssue';
+
+const FALLBACK_ISSUE_URL = 'https://github.com/loophole-ai/loophole-ide/issues/new';
+
+/** The status bar priority: the higher, the further to the left. 99 puts it just before the problems indicator (50). */
+const REPORT_ISSUE_PRIORITY = 99;
+
+/**
+ * A "Report Issue" button in the status bar that opens the issue tracker from product.json (reportIssueUrl).
+ */
+export class ReportIssueStatusBarContribution extends Disposable implements IWorkbenchContribution {
+
+	static readonly ID = 'workbench.contrib.loopholeReportIssue';
+
+	constructor(
+		@IStatusbarService statusbarService: IStatusbarService,
+		@INativeHostService nativeHostService: INativeHostService,
+		@IProductService productService: IProductService,
+	) {
+		super();
+
+		// The address comes from product.json and not from content the person opened, so it goes straight to
+		// the browser instead of through the "trust this website?" prompt that would show on every click.
+		this._register(CommandsRegistry.registerCommand(REPORT_ISSUE_COMMAND_ID, () => {
+			return nativeHostService.openExternal(productService.reportIssueUrl || FALLBACK_ISSUE_URL);
+		}));
+
+		this._register(statusbarService.addEntry({
+			name: localize('loopholeReportIssue.name', "Report Issue"),
+			text: `$(bug) ${localize('loopholeReportIssue.text', "Report Issue")}`,
+			ariaLabel: localize('loopholeReportIssue.ariaLabel', "Report an issue on GitHub"),
+			tooltip: localize('loopholeReportIssue.tooltip', "Report a bug or request a feature on GitHub"),
+			command: REPORT_ISSUE_COMMAND_ID,
+		}, REPORT_ISSUE_COMMAND_ID, StatusbarAlignment.LEFT, REPORT_ISSUE_PRIORITY));
+	}
+}
+
+registerWorkbenchContribution2(ReportIssueStatusBarContribution.ID, ReportIssueStatusBarContribution, WorkbenchPhase.AfterRestored);
diff --git a/src/vs/workbench/workbench.desktop.main.ts b/src/vs/workbench/workbench.desktop.main.ts
index 4cf21feb..d7d3a9f9 100644
--- a/src/vs/workbench/workbench.desktop.main.ts
+++ b/src/vs/workbench/workbench.desktop.main.ts
@@ -212,6 +212,9 @@ import './contrib/policyExport/electron-browser/policyExport.contribution.js';
 // Keybindings Export
 import './contrib/keybindingsExport/electron-browser/keybindingsExport.contribution.js';
 
+// Loophole: Report Issue button in the status bar
+import './contrib/loopholeReportIssue/electron-browser/reportIssue.contribution.js';
+
 // System-wide (OS global) Keybindings
 import './contrib/keybindings/electron-browser/systemWideKeybindings.contribution.js';
 
