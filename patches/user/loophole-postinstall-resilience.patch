+// Loophole: a spawn failure (ENOENT) is a rare, transient CreateProcess error on busy Windows runners, but it is also what
+// Node reports when the working directory is missing. Retry a few times, and if it keeps failing say *why* instead of
+// only printing "spawn cmd.exe ENOENT".
+async function spawnAsyncWithRetry(dir: string, command: string, args: string[], opts: child_process.SpawnOptions): Promise<string> {
+	const attempts = 3;
+	for (let attempt = 1; ; attempt++) {
+		const cwd = typeof opts.cwd === 'string' ? opts.cwd : undefined;
+		if (cwd && !fs.existsSync(cwd)) {
+			throw new Error(`[${dir}] cannot install: working directory does not exist: ${cwd}`);
+		}
+		try {
+			return await spawnAsync(command, args, opts);
+		} catch (err) {
+			const code = (err as NodeJS.ErrnoException)?.code;
+			if (code !== 'ENOENT') {
+				throw err;
+			}
+			if (attempt >= attempts) {
+				const comspec = process.env['ComSpec'] || process.env['COMSPEC'];
+				throw new Error(`[${dir}] spawn failed with ENOENT after ${attempts} attempts: ${(err as Error).message}\n`
+					+ `  cwd exists: ${cwd ? fs.existsSync(cwd) : 'n/a'}, ComSpec=${comspec}, ComSpec exists: ${comspec ? fs.existsSync(comspec) : 'n/a'}, `
+					+ `free memory: ${Math.round(os.freemem() / 1048576)} MB`);
+			}
+			log(dir, `spawn failed with ENOENT, retrying (${attempt}/${attempts - 1})...`);
+			await new Promise(resolve => setTimeout(resolve, 5000 * attempt));
+		}
+	}
+}
