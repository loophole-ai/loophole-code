+
+import { createDecorator } from '../../../../platform/instantiation/common/instantiation.js';
+
+/** Editors we know how to import from. */
+export type TransferEditorType = 'VS Code' | 'Cursor' | 'Windsurf';
+
+export const transferEditorTypes: readonly TransferEditorType[] = ['VS Code', 'Cursor', 'Windsurf'];
+
+/** The things an import can copy over. */
+export type TransferItemKind = 'settings' | 'keybindings' | 'extensions';
+
+export interface IExtensionTransferResult {
+
+	/** What was found in the other editor and copied over. Empty if the editor has nothing to import. */
+	readonly imported: readonly TransferItemKind[];
+
+	/** One message per item that could not be copied. */
+	readonly errors: readonly string[];
+}
+
+export const IExtensionTransferService = createDecorator<IExtensionTransferService>('loopholeExtensionTransferService');
+
+export interface IExtensionTransferService {
+
+	readonly _serviceBrand: undefined;
+
+	/**
+	 * Copies the settings, keybindings and extensions of another editor into Loophole.
+	 * Settings and keybindings that already exist are backed up next to the originals first.
+	 */
+	transferFromEditor(editor: TransferEditorType): Promise<IExtensionTransferResult>;
+}
