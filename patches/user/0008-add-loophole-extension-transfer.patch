+/*--------------------------------------------------------------------------------------
+ *  Copyright 2026 Loophole AI, Inc. All rights reserved.
+ *  See LICENSE.txt for more information.
+ *--------------------------------------------------------------------------------------*/
+
+import { VSBuffer } from '../../../../base/common/buffer.js';
+import { toErrorMessage } from '../../../../base/common/errorMessage.js';
+import { isMacintosh, isWindows } from '../../../../base/common/platform.js';
+import { env } from '../../../../base/common/process.js';
+import { basename, dirname } from '../../../../base/common/resources.js';
+import { URI } from '../../../../base/common/uri.js';
+import { IFileService } from '../../../../platform/files/common/files.js';
+import { InstantiationType, registerSingleton } from '../../../../platform/instantiation/common/extensions.js';
+import { ILogService } from '../../../../platform/log/common/log.js';
+import { INativeWorkbenchEnvironmentService } from '../../../services/environment/electron-browser/environmentService.js';
+import { IExtensionTransferResult, IExtensionTransferService, TransferEditorType, TransferItemKind } from '../common/extensionTransfer.js';
+
+/**
+ * Extensions that are not copied over (matched against the extension id / folder name, lower case).
+ */
+const extensionBlacklist = [
+	// remote development extensions only work in Microsoft's builds
+	'ms-vscode-remote.remote', // ms-vscode-remote.remote-ssh, ms-vscode-remote.remote-wsl
+	'ms-vscode.remote', // ms-vscode.remote-explorer
+	// Loophole ships its own agent (built in), a second copy would clash with it
+	'kilocode.kilo-code',
+	// other AI assistants that would fight over the same keybindings
+	'sourcegraph.cody-ai',
+	'continue.continue',
+	'codeium.codeium',
+	'saoudrizwan.claude-dev', // cline
+	'rooveterinaryinc.roo-cline', // roo
+	'supermaven.supermaven',
+	'github.copilot', // also matches github.copilot-chat
+];
+
+function isBlacklisted(idOrName: string | undefined): boolean {
+	const value = idOrName?.toLowerCase();
+	return !!value && extensionBlacklist.some(item => value.includes(item));
+}
+
+/**
+ * Where each editor keeps its data.
+ * https://code.visualstudio.com/docs/editor/extension-marketplace#_where-are-extensions-installed
+ */
+const editorLocations: Record<TransferEditorType, { appFolder: string; dataFolder: string }> = {
+	'VS Code': { appFolder: 'Code', dataFolder: '.vscode' },
+	'Cursor': { appFolder: 'Cursor', dataFolder: '.cursor' },
+	'Windsurf': { appFolder: 'Windsurf', dataFolder: '.windsurf' },
+};
+
+interface ITransferItem {
+	readonly kind: TransferItemKind;
+	readonly from: URI;
+	readonly to: URI;
+}
+
+interface IExtensionManifestEntry {
+	readonly identifier?: { readonly id?: string };
+}
+
+class ExtensionTransferService implements IExtensionTransferService {
+
+	declare readonly _serviceBrand: undefined;
+
+	constructor(
+		@IFileService private readonly fileService: IFileService,
+		@INativeWorkbenchEnvironmentService private readonly environmentService: INativeWorkbenchEnvironmentService,
+		@ILogService private readonly logService: ILogService,
+	) { }
+
+	async transferFromEditor(editor: TransferEditorType): Promise<IExtensionTransferResult> {
+		const imported: TransferItemKind[] = [];
+		const errors: string[] = [];
+
+		for (const item of this.getTransferItems(editor)) {
+			try {
+				if (!await this.fileService.exists(item.from)) {
+					this.logService.info(`[loophole onboarding] nothing to import, ${item.from.toString()} does not exist`);
+					continue;
+				}
+
+				if (item.kind === 'extensions') {
+					await this.copyExtensions(item.from, item.to);
+				} else {
+					await this.copyFile(item.from, item.to);
+				}
+				imported.push(item.kind);
+			} catch (error) {
+				this.logService.error(`[loophole onboarding] could not import ${item.from.toString()}`, error);
+				errors.push(`${basename(item.from)}: ${toErrorMessage(error)}`);
+			}
+		}
+
+		return { imported, errors };
+	}
+
+	private getTransferItems(editor: TransferEditorType): ITransferItem[] {
+		const { appFolder, dataFolder } = editorLocations[editor];
+		const home = this.environmentService.userHome;
+
+		let appData: URI;
+		if (isWindows) {
+			appData = env['APPDATA'] ? URI.file(env['APPDATA']) : URI.joinPath(home, 'AppData', 'Roaming');
+		} else if (isMacintosh) {
+			appData = URI.joinPath(home, 'Library', 'Application Support');
+		} else {
+			appData = env['XDG_CONFIG_HOME'] ? URI.file(env['XDG_CONFIG_HOME']) : URI.joinPath(home, '.config');
+		}
+
+		const fromUserFolder = URI.joinPath(appData, appFolder, 'User');
+		const toUserFolder = this.environmentService.appSettingsHome;
+
+		return [
+			{ kind: 'settings', from: URI.joinPath(fromUserFolder, 'settings.json'), to: URI.joinPath(toUserFolder, 'settings.json') },
+			{ kind: 'keybindings', from: URI.joinPath(fromUserFolder, 'keybindings.json'), to: URI.joinPath(toUserFolder, 'keybindings.json') },
+			{ kind: 'extensions', from: URI.joinPath(home, dataFolder, 'extensions'), to: URI.file(this.environmentService.extensionsPath) },
+		];
+	}
+
+	private async copyFile(from: URI, to: URI): Promise<void> {
+		if (await this.fileService.exists(to)) {
+			// don't silently throw away what the user already has
+			await this.fileService.copy(to, URI.joinPath(dirname(to), `${basename(to)}.loophole-backup`), true);
+		} else {
+			await this.fileService.createFolder(dirname(to));
+		}
+
+		await this.fileService.copy(from, to, true);
+	}
+
+	private async copyExtensions(from: URI, to: URI): Promise<void> {
+		await this.fileService.createFolder(to);
+
+		const stat = await this.fileService.resolve(from);
+		for (const child of stat.children ?? []) {
+			if (child.isDirectory) {
+				if (!isBlacklisted(child.name)) {
+					await this.fileService.copy(child.resource, URI.joinPath(to, child.name), true);
+				}
+			} else if (child.name === 'extensions.json') {
+				await this.mergeExtensionsManifest(child.resource, URI.joinPath(to, child.name));
+			}
+		}
+	}
+
+	/**
+	 * extensions.json lists the installed extensions. Merge instead of replace,
+	 * so the extensions that are already installed in Loophole are not forgotten.
+	 */
+	private async mergeExtensionsManifest(from: URI, to: URI): Promise<void> {
+		const imported = (await this.readManifest(from)).filter(entry => !isBlacklisted(entry.identifier?.id));
+		const importedIds = new Set(imported.map(entry => entry.identifier?.id?.toLowerCase()));
+		const existing = (await this.fileService.exists(to) ? await this.readManifest(to) : [])
+			.filter(entry => !importedIds.has(entry.identifier?.id?.toLowerCase()));
+
+		await this.fileService.writeFile(to, VSBuffer.fromString(JSON.stringify([...existing, ...imported])));
+	}
+
+	private async readManifest(resource: URI): Promise<IExtensionManifestEntry[]> {
+		const content = await this.fileService.readFile(resource);
+		const manifest: unknown = JSON.parse(content.value.toString());
+		return Array.isArray(manifest) ? manifest : [];
+	}
+}
+
+registerSingleton(IExtensionTransferService, ExtensionTransferService, InstantiationType.Delayed);
